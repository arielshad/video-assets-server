---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/collections/Breadcrumbs.astro";
import CollectionCard from "@/components/collections/CollectionCard.astro";
import { COLLECTIONS_PATH, allCollections, allHubs, dateFmt, hubPath, latest } from "@/lib/collections";
import { breadcrumbs, collectionPage } from "@/lib/schema";
import { SOURCE_COUNT } from "@/lib/site";

const all = await allCollections();
const hubs = await allHubs();
const updated = latest(all);
const title = "Free stock footage collections";
const description = `Curated collections of free stock video from ${SOURCE_COUNT} sites: ocean, drone, space, timelapse, archive films and vertical clips, each with a licence verdict.`;
const trail = [{ name: "Home", path: "/" }, { name: "Footage collections", path: COLLECTIONS_PATH }];
---

<BaseLayout
  title={title}
  description={description}
  markdown={`${COLLECTIONS_PATH}.md`}
  schema={[
    collectionPage({ title, description, path: COLLECTIONS_PATH, dateModified: updated, links: [...hubs.map((h) => ({ name: h.title, path: hubPath(h) })), ...all.map((c) => ({ name: c.topic.data.title, path: c.path }))] }),
    breadcrumbs(trail),
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs trail={trail} />
    <header class="mt-6 max-w-3xl">
      <p class="text-sm font-medium text-primary">Video Assets Server</p>
      <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 text-pretty text-muted-foreground">
        Each collection answers one need, such as waves for an intro, a drone shot over a city, a rocket launch or a 1950s newsreel, with the best free matches from {SOURCE_COUNT} video sites side by side. Hover any card to watch its preview. Every clip shows its source, resolution and whether you may use it in a commercial video, and the lists are refreshed from a live search every day.
      </p>
      {updated && <p class="mt-3 text-sm text-muted-foreground">{all.length} collections, updated <time datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>.</p>}
    </header>

    {hubs.map((hub) => {
      const cs = all.filter((c) => c.hub.id === hub.id);
      return cs.length ? (
        <section class="mt-14" aria-labelledby={`hub-${hub.id}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id={`hub-${hub.id}`} class="text-2xl font-semibold tracking-tight"><a href={hubPath(hub)} class="hover:text-primary">{hub.title}</a></h2>
            <a href={hubPath(hub)} class="text-sm text-primary underline underline-offset-2 hover:decoration-2">All {hub.name.toLowerCase()} →</a>
          </div>
          <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {cs.map((c) => <CollectionCard collection={c} />)}
          </ul>
        </section>
      ) : null;
    })}

    <p class="mt-16 text-sm text-muted-foreground">
      Looking for something else? <a href="/search" class="text-primary underline underline-offset-2 hover:decoration-2">Search all {SOURCE_COUNT} sites</a>, <a href="/sequence" class="text-primary underline underline-offset-2 hover:decoration-2">build a b-roll sequence</a>, or see <a href="/docs/sources" class="text-primary underline underline-offset-2 hover:decoration-2">every source and its licence</a>.
    </p>
  </div>
</BaseLayout>
<script>
  import "@/scripts/preview-video";
</script>
