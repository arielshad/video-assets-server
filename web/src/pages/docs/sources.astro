---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { sourcesList } from "@/lib/schema";
import { PROVIDERS, SOURCE_COUNT } from "@/lib/site";
import { VERDICT_LABELS, categoryLabel, verdictTone, type Verdict } from "@/lib/vocab";

const access = { api: "API", static: "Catalogue", scrape: "Site search", link: "Deep link" } as const;
const pricing = { free: "Free", freemium: "Free + paid", paid: "Paid" } as const;
const toneClass = { green: "text-success", amber: "text-warning", red: "text-destructive" } as const;
const headings = [{ depth: 2, slug: "all-sources", text: "All sources" }, { depth: 2, slug: "how-sources-are-searched", text: "How sources are searched" }, { depth: 2, slug: "licences", text: "Licences" }];
---

<DocsLayout
  title="Sources & licences"
  crumb="Sources & licences"
  description={`The ${SOURCE_COUNT} video sites searched or linked (NASA, Wikimedia Commons, Internet Archive, Pexels, Pixabay…) with footage, pricing, licences and downloads.`}
  headings={headings}
  schema={[sourcesList()]}
>
  <h1>Sources &amp; licences</h1>
  <p>
    One search covers {SOURCE_COUNT} sites. Each result keeps its source's licence and gets a verdict on commercial use and an editorial flag, so you can tell at a glance whether a clip can go into a commercial video and whether you have to credit it. Video never passes through this server: posters, previews and downloads come straight from each source.
  </p>

  <h2 id="all-sources">All sources</h2>
  <div class="not-prose overflow-x-auto rounded-xl border">
    <table class="w-full text-sm">
      <thead class="bg-muted/50 text-left text-xs uppercase tracking-wide text-muted-foreground">
        <tr>
          <th class="px-4 py-3 font-medium">Source</th>
          <th class="px-4 py-3 font-medium">Best for</th>
          <th class="px-4 py-3 font-medium">Search</th>
          <th class="px-4 py-3 font-medium">Pricing</th>
          <th class="px-4 py-3 font-medium">Licence</th>
          <th class="px-4 py-3 font-medium">Direct download</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        {PROVIDERS.map((p) => (
          <tr id={p.id} class="scroll-mt-24 align-top target:bg-primary/10">
            <td class="px-4 py-3 font-medium">
              <a href={`/sources/${p.id}`} class="text-primary underline underline-offset-2 hover:decoration-2">{p.name}</a>
              <div class="mt-1 font-mono text-[11px] font-normal text-muted-foreground">{p.id} · <a href={p.homepage} class="hover:text-foreground" rel="noopener">site ↗</a></div>
            </td>
            <td class="px-4 py-3 text-muted-foreground">
              {p.description}
              {p.categories.length > 0 && <div class="mt-1 text-xs">{p.categories.map(categoryLabel).join(", ")}</div>}
            </td>
            <td class="px-4 py-3 whitespace-nowrap">{access[p.access]}</td>
            <td class="px-4 py-3 whitespace-nowrap">{pricing[p.pricing]}</td>
            <td class="px-4 py-3">
              {p.license ?? "Per clip"}
              {p.licenseVerdict && <div class:list={["mt-1 text-xs", toneClass[verdictTone(p.licenseVerdict)]]}>{VERDICT_LABELS[p.licenseVerdict as Verdict] ?? p.licenseVerdict}</div>}
            </td>
            <td class="px-4 py-3">{p.supportsDownload ? "Yes" : "Source page"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="how-sources-are-searched">How sources are searched</h2>
  <ul>
    <li><strong>API</strong>: the source's official or public JSON API (NASA's Image and Video Library and Scientific Visualization Studio, the MediaWiki API for Wikimedia Commons, the Internet Archive's advanced search). These give the licence per clip, author, frame size, length and direct files.</li>
    <li><strong>Deep link</strong>: the site needs an API key, sells its footage, or its terms forbid automated search or aggregation (Pexels, Pixabay, Coverr, Mixkit, the paid stock libraries and others). Every search response includes a link that runs the same query on that site, so you still know where else to look.</li>
  </ul>
  <p>Every source has its own timeout. A slow or failing site shows up in the per-source report and never fails the search. Categories, orientation and resolution that a source doesn't state are filled in from titles, tags and frame sizes; facts only a clip's own page holds are read when you open it.</p>

  <h2 id="licences">Licences</h2>
  <p>
    Each result's <code>license</code> carries an SPDX-style <code>id</code>, a <code>name</code>, whether credit is required, who asserted it (<code>source</code>, <code>site</code> or <code>uploader</code>), an <code>editorial</code> flag and a <code>verdict</code> on commercial use. <strong>CC0</strong> and public-domain clips need no credit. <strong>NASA media</strong> is generally not copyrighted in the US but needs credit and comes with endorsement and insignia rules. <strong>CC BY</strong> needs a credit line, <strong>share-alike</strong> licences relicense the whole video, <strong>NC</strong> and <strong>ND</strong> licences rule out commercial use, and uploader-asserted licences are never better than "check the terms".
    The full rules, with examples, are in <a href="/docs/licences">Video licences explained</a>.
  </p>
</DocsLayout>
