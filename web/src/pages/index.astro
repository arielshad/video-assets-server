---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AgentSetup from "@/components/home/AgentSetup";
import GridPattern from "@/components/home/GridPattern.astro";
import { AnimatedShinyText } from "@/components/ui/animated-shiny-text";
import { Marquee } from "@/components/ui/marquee";
import { EXAMPLE_PROMPTS } from "@/lib/agents";
import { FAQ } from "@/lib/faq";
import { faqPage, softwareApplication, webApi } from "@/lib/schema";
import { CATALOG, HAS_CATALOG, fmt, fmtShort } from "@/lib/catalog";
import { EXAMPLE_QUERIES as suggestions, LINKED, MCP_NAME, MCP_URL, PROVIDERS, SEARCHED, SITE, SOURCE_COUNT } from "@/lib/site";
import { COLLECTIONS_PATH, allCollections, allHubs, hubPath } from "@/lib/collections";
import { allGuides, guidePath } from "@/lib/guides";
import { VERDICTS_BY_TONE, VERDICT_LABELS, VERDICT_MEANING, categoryLabel } from "@/lib/vocab";

const totals = CATALOG.totals;
const stats = [
  { value: String(SOURCE_COUNT), label: "video sites in one search" },
  ...(HAS_CATALOG && totals.free.count
    ? [{ value: fmtShort(totals.free.count, totals.free.atLeast), exact: fmt(totals.free.count, totals.free.atLeast), label: "free videos to search" }]
    : [{ value: "4K", label: "resolution, shape and length filters" }]),
  { value: "0", label: "bytes of video through this server" },
  { value: "0", label: "accounts or API keys needed" },
];
const exampleShots = ["City skyline at night (4s)", "Coffee pour close-up (3s)", "People walking in the rain", "Ocean waves at sunset", "Clouds timelapse (5s)"];
const sequenceHref = `/sequence?${new URLSearchParams({ shots: exampleShots.join("\n"), orientation: "portrait", total: "20" })}`;
const direct = [
  { title: "Watch from the source", body: "Posters, hover previews and the player load straight from NASA, Wikimedia and the Internet Archive. Hover any card to see it move." },
  { title: "Download from the source", body: "Pick a rendition, from a small preview to the 4K master: the download is a redirect to the file on the source's CDN." },
  { title: "Credits written for you", body: "Every clip that needs credit has a ready credit line, and ATTRIBUTION.md for one clip or a whole sequence." },
];
const surfaces = [
  {
    title: "Web search",
    body: "Describe the shot, filter by category, shape, resolution and length, hover to preview and open the player. Every card shows its licence verdict.",
    href: "/search",
    cta: "Open search",
    code: `${SITE.url.replace("https://", "")}/search?q=ocean+waves&orientation=portrait`,
  },
  {
    title: "REST API & CLI",
    body: "JSON with an OpenAPI 3.1 spec: search, read licences and credit lines, get renditions as redirects to the source, plan sequences. The same from npx.",
    href: "/docs/api",
    cta: "API guide",
    code: `npx video-assets-server search "4k vertical drone ocean"`,
  },
  {
    title: "MCP for AI agents",
    body: "Give Claude, Cursor or Copilot tools to find, vet and fetch footage, and to cut whole b-roll sequences, while they build your video or app.",
    href: "/docs/mcp",
    cta: "Connect an agent",
    code: `claude mcp add --transport http ${MCP_NAME} ${MCP_URL}`,
  },
];
const tones = [
  { tone: "green", title: "Green: use it", ring: "border-success/40", dot: "bg-success", text: "text-success", body: "CC0 and public-domain footage, plus CC BY and NASA media when you credit the source. Turn on Commercial-safe to see only these." },
  { tone: "amber", title: "Amber: read first", ring: "border-warning/40", dot: "bg-warning", text: "text-warning", body: "Share-alike, unverified uploader claims, third-party footage and paid stock that needs a licence or releases." },
  { tone: "red", title: "Red: not for commercial use", ring: "border-destructive/40", dot: "bg-destructive", text: "text-destructive", body: "Non-commercial and no-derivatives licences. Fine for study and personal projects, not for ads or client work." },
] as const;
const collections = (await allCollections()).filter((c) => c.indexable);
const hubs = await allHubs();
const featured = SEARCHED.slice(0, 12);
const guides = (await allGuides()).slice(0, 8);
---


<BaseLayout title={SITE.name} description={SITE.description} schema={[softwareApplication(), webApi(), faqPage(FAQ)]}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-border/60">
    <GridPattern class="absolute inset-0 -z-10 h-full w-full [mask-image:radial-gradient(640px_circle_at_50%_30%,white,transparent)] skew-y-6 fill-primary/20 stroke-primary/15" />
    <div class="pointer-events-none absolute left-1/2 top-[-12rem] -z-10 h-[32rem] w-[64rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklch,var(--color-primary)_28%,transparent),transparent)] blur-2xl"></div>
    <div class="mx-auto max-w-5xl px-4 pb-20 pt-20 text-center sm:px-6 sm:pt-28">
      <a href="/sequence" class="group mx-auto inline-flex max-w-full items-center rounded-full border border-border bg-card/60 px-1 py-1 pr-3 text-sm backdrop-blur transition hover:border-primary/40">
        <span class="mr-2 shrink-0 rounded-full bg-primary/15 px-2 py-0.5 text-xs font-medium text-primary">New</span>
        <AnimatedShinyText className="mx-0 max-w-none truncate">Sequence builder: a shot list in, a b-roll edit out</AnimatedShinyText>
        <span class="ml-1 text-muted-foreground transition group-hover:translate-x-0.5">→</span>
      </a>
      <h1 class="mx-auto mt-7 max-w-4xl text-balance text-4xl font-semibold tracking-tight sm:text-6xl">
        <span class="mb-3 block text-base font-medium tracking-normal text-muted-foreground sm:text-lg">Video Assets Server</span>
        Every free stock clip,{" "}
        <span class="bg-gradient-to-r from-primary via-[color-mix(in_oklch,var(--color-primary)_50%,var(--color-brand-2))] to-brand-2 bg-clip-text text-transparent">one search</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg text-muted-foreground">
        B-roll, backgrounds, nature, cities, space and archive films from {SOURCE_COUNT} video sites at once. Watch each clip, pick the size you need, and get a clear answer to the question that matters: can I put this in a commercial video? In your browser, over an API, or from your AI agent.
      </p>

      <form action="/search" method="get" role="search" class="relative mx-auto mt-10 max-w-2xl">
        <label for="hero-q" class="sr-only">Search stock video</label>
        <div class="flex items-center gap-2 rounded-2xl border bg-card/80 p-2 shadow-2xl shadow-primary/10 ring-1 ring-primary/10 backdrop-blur focus-within:ring-2 focus-within:ring-primary/40">
          <svg class="ml-2 size-5 shrink-0 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="hero-q" name="q" type="search" required autocomplete="off" placeholder="ocean waves at sunset, 4k vertical drone…" class="h-11 min-w-0 flex-1 bg-transparent text-base outline-none placeholder:text-muted-foreground/70" />
          <button type="submit" class="h-11 shrink-0 rounded-xl bg-primary px-5 text-sm font-medium text-primary-foreground transition hover:opacity-90">Search</button>
        </div>
      </form>
      <div class="mx-auto mt-4 flex max-w-2xl flex-wrap justify-center gap-2 text-sm">
        <span class="text-muted-foreground">Try:</span>
        {suggestions.map((s) => (
          <a href={`/search?q=${encodeURIComponent(s)}`} class="rounded-full border border-border/70 px-3 py-0.5 text-muted-foreground transition hover:border-primary/40 hover:text-foreground">{s}</a>
        ))}
      </div>

      <dl class="mx-auto mt-14 grid max-w-3xl grid-cols-2 gap-6 sm:grid-cols-4">
        {stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-3xl font-semibold tabular-nums tracking-tight" title={"exact" in s ? s.exact : undefined}>{s.value}</dd>
            <dd class="mt-1 text-xs text-muted-foreground">{s.label}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-sm"><a href="/stats" class="text-muted-foreground transition hover:text-foreground">Counted daily across every source · see the numbers →</a></p>
    </div>

    <div class="relative border-t border-border/60 py-6">
      <p class="sr-only">Sources searched or linked:</p>
      <Marquee pauseOnHover className="[--duration:45s] [--gap:2.5rem]">
        {PROVIDERS.map((p) => (
          <a href={`/sources/${p.id}`} class="whitespace-nowrap text-sm font-medium text-muted-foreground transition hover:text-foreground">{p.name}</a>
        ))}
      </Marquee>
      <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-background"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-background"></div>
    </div>
  </section>

  <!-- Product preview -->
  <section class="mx-auto max-w-6xl px-4 pt-20 sm:px-6" aria-labelledby="preview">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium text-primary">See it in action</p>
      <h2 id="preview" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Hover to watch, with the licence on every card</h2>
      <p class="mt-4 text-muted-foreground">Results come back as a grid of posters with resolution, shape and length. Hover one and its muted preview plays straight from the source; open it for the full player, every rendition and the credit line.</p>
    </div>
    <figure class="mt-10">
      <div class="overflow-hidden rounded-2xl border bg-card/50 shadow-2xl shadow-primary/10 ring-1 ring-primary/10">
        <picture>
          <source type="image/avif" srcset="/img/search-preview.avif" />
          <source type="image/webp" srcset="/img/search-preview.webp" />
          <img
            src="/img/search-preview.png"
            width="1280"
            height="800"
            loading="lazy"
            decoding="async"
            alt="Video Assets Server search results for “ocean waves”: a grid of video posters, each with a resolution badge, its length, the source and a green, amber or red licence badge, under category chips and orientation, resolution, length and Commercial-safe filters."
            class="block h-auto w-full"
          />
        </picture>
      </div>
      <figcaption class="mt-3 text-center text-sm text-muted-foreground">
        A search for “ocean waves”. <a href="/search?q=ocean+waves" class="text-primary underline decoration-primary/40 underline-offset-2">Try it yourself</a>.
      </figcaption>
    </figure>
    <ul class="mx-auto mt-12 grid max-w-5xl gap-4 sm:grid-cols-3">
      {direct.map((d) => (
        <li class="rounded-2xl border bg-card/40 p-5">
          <h3 class="font-semibold">{d.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{d.body}</p>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-center text-xs text-muted-foreground">No video ever passes through this server: it searches, reads metadata and writes credits. <a href="/docs#no-video-through-the-server" class="text-primary underline underline-offset-2">How it works</a></p>
  </section>

  <!-- Licence verdicts -->
  <section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6" aria-labelledby="verdicts">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium text-primary">Licence first</p>
      <h2 id="verdicts" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Green, amber or red, before the clip is in your timeline</h2>
      <p class="mt-4 text-muted-foreground">
        Stock footage licences hide traps: share-alike that relicenses your whole video, non-commercial clauses, uploads nobody checked, and people or logos that rule out an ad. Every result carries one verdict, decided the same way for every source, plus an editorial flag when releases are missing.
      </p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {tones.map((t) => (
        <div class:list={["rounded-2xl border bg-card/50 p-6", t.ring]}>
          <h3 class="flex items-center gap-2 font-semibold"><span class:list={["size-2.5 rounded-full", t.dot]} aria-hidden="true"></span>{t.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{t.body}</p>
          <ul class="mt-4 space-y-3">
            {VERDICTS_BY_TONE[t.tone].map((v) => (
              <li class="text-sm">
                <span class:list={["font-medium", t.text]}>{VERDICT_LABELS[v]}</span>
                <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">{VERDICT_MEANING[v]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-sm"><a href="/docs/licences" class="text-primary underline underline-offset-2 hover:decoration-2">Video licences explained: CC0, CC BY, share-alike, NASA media, editorial use, credit lines →</a></p>
  </section>

  <!-- What it searches -->
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6" aria-labelledby="sources">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-medium text-primary">What it searches</p>
      <h2 id="sources" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{SOURCE_COUNT} video sites, one result list</h2>
      <p class="mt-4 text-muted-foreground">
        NASA's libraries, Wikimedia Commons and the Internet Archive are searched directly, with their licences per clip and direct files. Free stock sites and paid libraries that don't allow automated search get a link that runs the same search there.
      </p>
    </div>
    <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((p) => (
        <li>
          <a href={`/sources/${p.id}`} class="group flex h-full flex-col rounded-xl border bg-card/40 p-4 transition hover:border-primary/40 hover:bg-card">
            <span class="font-medium group-hover:text-primary">{p.name}</span>
            <span class="mt-1 line-clamp-4 text-sm text-muted-foreground">{p.description}</span>
            {p.categories.length > 0 && <span class="mt-auto pt-3 text-xs text-muted-foreground">{p.categories.slice(0, 4).map(categoryLabel).join(" · ")}</span>}
          </a>
        </li>
      ))}
    </ul>
    {LINKED.length > 0 && (
      <div class="mx-auto mt-8 max-w-4xl text-center">
        <p class="text-sm text-muted-foreground">Every search also links to the same query on:</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-2 text-sm">
          {LINKED.map((p) => <li><a href={`/sources/${p.id}`} class="inline-flex rounded-full border px-3 py-0.5 text-muted-foreground transition hover:border-primary/40 hover:text-foreground">{p.name}</a></li>)}
        </ul>
      </div>
    )}
    <p class="mt-6 text-center text-sm"><a href="/docs/sources" class="text-primary underline underline-offset-2 hover:decoration-2">All sources and their licences →</a></p>
  </section>

  <!-- Sequence builder -->
  <section class="border-t border-border/60" aria-labelledby="sequence">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="text-sm font-medium text-primary">Sequence builder</p>
        <h2 id="sequence" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Write a shot list, get a b-roll edit</h2>
        <p class="mt-4 text-muted-foreground">
          One line per shot, with lengths where they matter. Each shot gets the best matching clip in your frame shape, at least 1080p where possible, long enough and commercial-safe, with alternatives. Take it into your editor as OpenTimelineIO, render it with the ffmpeg script, or drive a Remotion composition, with ATTRIBUTION.md for the credits.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2 text-xs">
          {["timeline.otio", "concat.sh", "remotion.json", "ATTRIBUTION.md"].map((f) => <li class="rounded-md border bg-card/60 px-2 py-1 font-mono text-muted-foreground">{f}</li>)}
        </ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={sequenceHref} class="rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition hover:opacity-90">Try this shot list</a>
          <a href="/guides/b-roll-sequence-from-shot-list" class="rounded-xl border px-5 py-2.5 text-sm font-medium transition hover:bg-accent">Read the guide</a>
        </div>
      </div>
      <div class="overflow-hidden rounded-2xl border bg-[#0d0d12] shadow-2xl shadow-primary/10">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2 text-xs text-zinc-400">
          <span>shots.txt · 9:16 · 20 s</span>
          <span class="font-mono">POST /v1/sequences</span>
        </div>
        <ol class="divide-y divide-white/5 font-mono text-[13px] text-zinc-200">
          {exampleShots.map((shot, i) => (
            <li class="flex items-center gap-3 px-4 py-2.5">
              <span class="w-4 text-right text-zinc-500">{i + 1}</span>
              <span class="min-w-0 flex-1 truncate">{shot}</span>
            </li>
          ))}
        </ol>
        <p class="border-t border-white/10 px-4 py-3 text-xs text-zinc-400">→ one clip per shot, alternatives, notes when a clip is cropped or upscaled, and the exports</p>
      </div>
    </div>
  </section>

  <!-- Three ways -->
  <section class="border-t border-border/60" aria-labelledby="ways">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-medium text-primary">Three ways in</p>
        <h2 id="ways" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Use it however you make video</h2>
        <p class="mt-4 text-muted-foreground">The same search, licence rules and source links behind a website, a REST API and CLI, and an MCP server.</p>
      </div>
      <div class="mt-14 grid gap-4 md:grid-cols-3">
        {surfaces.map((s) => (
          <a href={s.href} class="group relative flex min-w-0 flex-col overflow-hidden rounded-2xl border bg-card/50 p-6 transition hover:border-primary/40 hover:bg-card">
            <h3 class="text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm text-muted-foreground">{s.body}</p>
            <code class="mt-6 block truncate rounded-lg border bg-[#0d0d12] px-3 py-2 font-mono text-xs text-zinc-300">{s.code}</code>
            <span class="mt-5 text-sm font-medium text-primary">{s.cta} <span class="inline-block transition group-hover:translate-x-0.5">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Agents -->
  <section class="border-y border-border/60 bg-card/30" aria-labelledby="agents">
    <div class="mx-auto grid max-w-7xl items-start gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[1fr_1.15fr]">
      <div class="min-w-0">
        <p class="text-sm font-medium text-primary">For AI agents</p>
        <h2 id="agents" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Let your agent find the footage</h2>
        <p class="mt-4 text-muted-foreground">
          Connect the MCP server once, under the name <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-sm">{MCP_NAME}</code>. Your agent can then search every source, check each licence, fetch the right rendition and cut b-roll sequences while it builds your video, site or app. It searches commercial-safe by default and is told never to pass off a non-commercial, unclear or editorial-only clip as cleared for ads.
        </p>
        <ul class="mt-8 space-y-3">
          {EXAMPLE_PROMPTS.map((p) => (
            <li class="flex gap-3 rounded-xl border bg-background/60 px-4 py-3 text-sm">
              <span class="font-mono text-primary">›</span><span>{p}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-muted-foreground">
          Agents that only browse the web can read <a class="text-primary underline decoration-primary/40 underline-offset-2" href="/AGENTS.md">/AGENTS.md</a> or <a class="text-primary underline decoration-primary/40 underline-offset-2" href="/llms.txt">/llms.txt</a> and call the REST API directly. <a class="text-primary underline decoration-primary/40 underline-offset-2" href="/docs/mcp">Full setup guide →</a>
        </p>
      </div>
      <div class="min-w-0">
        <AgentSetup client:visible />
      </div>
    </div>
  </section>

  <!-- Collections -->
  {(hubs.length > 0 || collections.length > 0) && (
    <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6" aria-labelledby="browse">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-medium text-primary">Browse</p>
        <h2 id="browse" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Free footage collections</h2>
        <p class="mt-4 text-muted-foreground">Saved searches for the footage editors ask for most, refreshed daily, with a licence verdict on every clip.</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {hubs.map((h) => (
          <a href={hubPath(h)} class="group rounded-2xl border p-5 transition hover:border-primary/40 hover:bg-card">
            <h3 class="font-semibold">{h.title}</h3>
            <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{h.description}</p>
            <span class="mt-3 inline-block text-sm text-primary">Browse <span class="inline-block transition group-hover:translate-x-0.5">→</span></span>
          </a>
        ))}
      </div>
      {collections.length > 0 && (
        <div class="mt-8 text-center">
          <h3 class="text-sm font-medium text-muted-foreground">Popular collections</h3>
          <ul class="mx-auto mt-3 flex max-w-4xl flex-wrap justify-center gap-2 text-sm">
            {collections.map((c) => (
              <li><a href={c.path} class="inline-flex rounded-full border px-3 py-1 text-muted-foreground transition hover:border-primary/40 hover:text-foreground">{c.topic.data.title}</a></li>
            ))}
          </ul>
        </div>
      )}
      <p class="mt-6 text-center text-sm"><a href={COLLECTIONS_PATH} class="text-primary underline underline-offset-2 hover:decoration-2">All footage collections →</a></p>
    </section>
  )}

  <!-- Guides -->
  {guides.length > 0 && (
    <section class="border-t border-border/60" aria-labelledby="guides">
      <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-medium text-primary">Learn</p>
          <h2 id="guides" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Guides to footage and licences</h2>
          <p class="mt-4 text-muted-foreground">Short answers first, details after: what you may publish, how to credit, NASA and archive rules, vertical video and b-roll workflows.</p>
        </div>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {guides.map((g) => (
            <li class="group relative rounded-2xl border p-5 transition hover:border-primary/40 hover:bg-card">
              <h3 class="font-medium leading-snug group-hover:text-primary"><a href={guidePath(g.id)} class="after:absolute after:inset-0">{g.data.title}</a></h3>
              <p class="mt-2 line-clamp-3 text-sm text-muted-foreground">{g.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-center text-sm"><a href="/guides" class="text-primary underline underline-offset-2 hover:decoration-2">All guides</a> · <a href="/glossary" class="text-primary underline underline-offset-2 hover:decoration-2">Glossary</a> · <a href="/docs/faq" class="text-primary underline underline-offset-2 hover:decoration-2">FAQ</a></p>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="border-t border-border/60" aria-labelledby="faq">
    <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
      <h2 id="faq" class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">Questions</h2>
      <div class="mt-10 divide-y divide-border rounded-2xl border bg-card/40">
        {FAQ.map((f, i) => (
          <details class="group px-5 py-4" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium [&::-webkit-details-marker]:hidden">
              <h3 class="text-base">{f.q}</h3>
              <span class="text-muted-foreground transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden border-t border-border/60">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_50%_100%,color-mix(in_oklch,var(--color-primary)_18%,transparent),transparent)]"></div>
    <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Stop digging through twenty stock sites</h2>
      <p class="mt-4 text-muted-foreground">Search once, watch as you go, and know which clips you can publish before they end up in your timeline.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/search" class="rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition hover:opacity-90">Start searching</a>
        <a href="/sequence" class="rounded-xl border px-5 py-2.5 text-sm font-medium transition hover:bg-accent">Build a sequence</a>
        <a href="/docs" class="rounded-xl border px-5 py-2.5 text-sm font-medium transition hover:bg-accent">Read the docs</a>
      </div>
    </div>
  </section>
</BaseLayout>
